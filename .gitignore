# Gem test scratch: generator destination root and dummy-app runtime dirs
/gem/tmp/
/gem/test/dummy/log/*
!/gem/test/dummy/log/.keep
/gem/test/dummy/tmp/*
!/gem/test/dummy/tmp/.keep
/gem/test/dummy/storage/*
!/gem/test/dummy/storage/.keep
