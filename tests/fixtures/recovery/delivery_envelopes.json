{
  "description": "Retained-publication deliveries, as they arrive in the `message` body of an ordinary ActionCable frame addressed with the recovery subscription's identifier. `generation` and `sequence` are decimal strings (JS-safe), `publication_id` is the stable deduplication key, `json_payload` is the exact Rails-encoded payload text, and `cursor` must name the same position the envelope already reports. Generated by the Rust implementation; no gem code produces this envelope.",
  "cases": [
    {
      "name": "valid_delivery",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{\\\"body\\\":\\\"hi\\\",\\\"pi\\\":1.0000000000000002}\"}"
      },
      "expect": {
        "valid": true,
        "version": 1,
        "stream": "chat:42",
        "publication_id": "8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d",
        "generation": "1",
        "sequence": "7",
        "cursor": "eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=",
        "json_payload": "{\"body\":\"hi\",\"pi\":1.0000000000000002}"
      }
    },
    {
      "name": "absent_version_defaults_to_one_and_unknown_fields_are_ignored",
      "envelope": "delivery",
      "input": {
        "wire": "{\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\",\"node\":\"a-1\"}"
      },
      "expect": {
        "valid": true,
        "version": 1,
        "stream": "chat:42",
        "sequence": "7",
        "json_payload": "{}"
      }
    },
    {
      "name": "unicode_payload_is_forwarded_byte_for_byte",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"stream:ünïcode/🚀\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"2\",\"sequence\":\"9007199254740993\",\"cursor\":\"eyJ2IjoxLCJnIjoiMiIsInMiOiI5MDA3MTk5MjU0NzQwOTkzIn0=\",\"json_payload\":\"{\\\"body\\\":\\\"caf\\\\u00e9 🚀\\\"}\"}"
      },
      "expect": {
        "valid": true,
        "version": 1,
        "stream": "stream:ünïcode/🚀",
        "sequence": "9007199254740993",
        "json_payload": "{\"body\":\"caf\\u00e9 🚀\"}"
      }
    },
    {
      "name": "wrong_message_type",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_recovery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "disallowed_value" }
    },
    {
      "name": "empty_stream",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "empty_stream" }
    },
    {
      "name": "publication_id_is_not_a_uuid",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"not-a-uuid\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "invalid_uuid" }
    },
    {
      "name": "payload_is_not_json",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{oops\"}"
      },
      "expect": { "valid": false, "error_kind": "invalid_json_payload" }
    },
    {
      "name": "sequence_is_not_a_number",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"seven\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "disallowed_value" }
    },
    {
      "name": "cursor_disagrees_with_the_position_it_accompanies",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":1,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiIwIn0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "mismatch" }
    },
    {
      "name": "unsupported_version",
      "envelope": "delivery",
      "input": {
        "wire": "{\"version\":99,\"type\":\"orbitcast_delivery\",\"stream\":\"chat:42\",\"publication_id\":\"8f14e45f-ce0a-4f2e-9b2b-2a1f3a4b5c6d\",\"generation\":\"1\",\"sequence\":\"7\",\"cursor\":\"eyJ2IjoxLCJnIjoiMSIsInMiOiI3In0=\",\"json_payload\":\"{}\"}"
      },
      "expect": { "valid": false, "error_kind": "unsupported_version" }
    }
  ]
}
