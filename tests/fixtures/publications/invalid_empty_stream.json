{
  "description": "Notices with an empty logical stream. Absent fields default to empty, and empty fails validation closed; producers must also refuse to publish to an empty stream.",
  "cases": [
    {
      "name": "inline_empty_stream",
      "input": {
        "wire": "{\"version\":1,\"kind\":\"inline\",\"publication\":{\"version\":1,\"namespace\":\"example_production\",\"id\":\"4b8e6cb6-56f1-4f3e-9c86-3d1b2f0a7c11\",\"stream\":\"\",\"json_payload\":\"{}\"}}"
      },
      "expect": {
        "valid": false,
        "error_kind": "empty_stream"
      }
    },
    {
      "name": "overflow_empty_stream",
      "input": {
        "wire": "{\"version\":1,\"kind\":\"overflow\",\"id\":\"9d2f1c04-7c3a-4e5b-8a66-f0e9d8c7b6a5\",\"namespace\":\"demo\",\"stream\":\"\"}"
      },
      "expect": {
        "valid": false,
        "error_kind": "empty_stream"
      }
    }
  ]
}
