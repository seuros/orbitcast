        "kind": "inline",
        "namespace": "café",
        "stream": "stream:ünïcode",
        "id": "9d2f1c04-7c3a-4e5b-8a66-f0e9d8c7b6a5",
        "json_payload": "{}",
        "channel": "orbitcast_b630c21a8012cd05b047cec754aad9601a46823df496aa85"
      }
    }
  ]
}
