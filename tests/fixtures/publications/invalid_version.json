{
  "description": "Structurally valid envelopes declaring an unsupported version. Parsing succeeds; semantic validation must reject them (never downgrade to the current version).",
  "cases": [
    {
      "name": "notice_version_99",
      "input": {
        "wire": "{\"version\":99,\"kind\":\"overflow\",\"id\":\"9d2f1c04-7c3a-4e5b-8a66-f0e9d8c7b6a5\",\"namespace\":\"demo\",\"stream\":\"posts:1\"}"
      },
      "expect": {
        "valid": false,
        "error_kind": "unsupported_version"
      }
    },
    {
      "name": "publication_version_0",
      "input": {
        "wire": "{\"version\":1,\"kind\":\"inline\",\"publication\":{\"version\":0,\"namespace\":\"example_production\",\"id\":\"4b8e6cb6-56f1-4f3e-9c86-3d1b2f0a7c11\",\"stream\":\"chat:42\",\"json_payload\":\"{}\"}}"
      },
      "expect": {
        "valid": false,
        "error_kind": "unsupported_version"
      }
    }
  ]
}
