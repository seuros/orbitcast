{
  "description": "Subscription operations carry the connection snapshot plus the subscription this node holds. `identifier` is the client's original string, byte for byte; `params` is a convenience decode of it and is never authoritative.",
  "cases": [
    {
      "name": "open_channel_request",
      "envelope": "request",
      "input": {
        "wire": "{\"version\":1,\"operation\":\"open_channel\",\"namespace\":\"example_production\",\"node_id\":\"node-7\",\"session_id\":\"2f4a6c8e-1b3d-4f5a-9c7e-0d1a2b3c4d5e\",\"request_id\":\"1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f\",\"sequence\":2,\"expected_revision\":1,\"deadline_ms\":1000,\"connection\":{\"url\":\"/cable\",\"client_address\":\"203.0.113.7\",\"identity\":{\"identity_key\":\"user:7\"}},\"subscription\":{\"identifier\":\"{\\\"channel\\\":\\\"ChatChannel\\\",\\\"room\\\":\\\"42\\\"}\",\"params\":{\"channel\":\"ChatChannel\",\"room\":\"42\"},\"streams\":[],\"state\":{}}}"
      },
      "expect": {
        "valid": true,
        "version": 1,
        "operation": "open_channel",
        "namespace": "example_production",
        "node_id": "node-7",
        "session_id": "2f4a6c8e-1b3d-4f5a-9c7e-0d1a2b3c4d5e",
        "request_id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
        "sequence": 2,
        "expected_revision": 1,
        "deadline_ms": 1000,
        "subscription": {
          "identifier": "{\"channel\":\"ChatChannel\",\"room\":\"42\"}",
          "params": { "channel": "ChatChannel", "room": "42" },
          "streams": []
        }
      }
    },
    {
      "name": "close_channel_request_reports_installed_streams",
      "envelope": "request",
      "input": {
        "wire": "{\"version\":1,\"operation\":\"close_channel\",\"namespace\":\"example_production\",\"node_id\":\"node-7\",\"session_id\":\"2f4a6c8e-1b3d-4f5a-9c7e-0d1a2b3c4d5e\",\"request_id\":\"4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a\",\"sequence\":5,\"expected_revision\":3,\"deadline_ms\":1000,\"connection\":{\"url\":\"/cable\",\"client_address\":\"203.0.113.7\"},\"subscription\":{\"identifier\":\"{\\\"channel\\\":\\\"ChatChannel\\\",\\\"room\\\":\\\"42\\\"}\",\"params\":{\"channel\":\"ChatChannel\",\"room\":\"42\"},\"streams\":[\"chat:42\"],\"state\":{\"last_read_id\":19}}}"
      },
      "expect": {
        "valid": true,
        "version": 1,
        "operation": "close_channel",
        "namespace": "example_production",
        "node_id": "node-7",
        "session_id": "2f4a6c8e-1b3d-4f5a-9c7e-0d1a2b3c4d5e",
        "request_id": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
        "sequence": 5,
        "expected_revision": 3,
        "deadline_ms": 1000,
        "subscription": {
          "identifier": "{\"channel\":\"ChatChannel\",\"room\":\"42\"}",
          "params": { "channel": "ChatChannel", "room": "42" },
          "streams": ["chat:42"]
        }
      }
    }
  ]
}
